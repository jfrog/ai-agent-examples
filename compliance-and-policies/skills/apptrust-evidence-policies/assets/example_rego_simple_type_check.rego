# checks that an evidence of a speciifc predicate type exists in either on the application version, the version sources (for example: builds) or on one of the packages inside the application version

package curation.policies/n/nimport rego.v1/n/napp_version := input.data.applications.getApplicationVersion/n/nversion_evidence := [predicate | predicate := app_version.evidenceSubject.evidenceConnection.edges[_].node]/n/nsource_evidence := [evidences |/n/tsource := app_version.sources[_]/n/tevidences := source.evidenceSubject.evidenceConnection.edges[_].node/n]/n/nartifact_evidence := [evidences |/n/treleasable := app_version.releasables.releasablesConnection.edges[_].node/n/tartifact := releasable.artifacts[_]/n/tevidences := artifact.evidenceSubject.evidenceConnection.edges[_].node/n]/n/nall_layers_evidences := array.concat(/n/tarray.concat(version_evidence, source_evidence),/n/tartifact_evidence,/n)/n/ndefault exists := false/n/nexists if {/n/tsome evidence in all_layers_evidences/n/tevidence.predicateType == input.params.predicateType/n}/n/nallow := {/n/t"should_allow": exists/n}