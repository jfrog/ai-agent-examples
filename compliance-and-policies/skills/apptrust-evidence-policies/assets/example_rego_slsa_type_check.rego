package curation.policies/nimport rego.v1/n/nrelease := input.data/n/napp_version := input.data.applications.getApplicationVersion/n/nversion_evidence := [predicate | predicate := app_version.evidenceSubject.evidenceConnection.edges[_].node]/n/nsource_evidence := [evidences |/n/tsource := app_version.sources[_]/n/tevidences := source.evidenceSubject.evidenceConnection.edges[_].node/n]/n/nartifacts_evidence := [evidences |/n/treleasable := app_version.releasables.releasablesConnection.edges[_].node/n/tartifact := releasable.artifacts[_]/n/tevidences := artifact.evidenceSubject.evidenceConnection.edges[_].node/n]/n/nall_layers_evidences := array.concat(/n/tarray.concat(version_evidence, source_evidence),/n/tartifacts_evidence,/n)/n/ndefault should_allow := false/n/nslsa_match(artifact_evidence) if {/n    artifact_evidence.predicateType == input.params.predicateType/n    runner_env := object.get(artifact_evidence.predicate.buildDefinition.internalParameters.github, "runner_environment", "")/n    runner_env == input.params.runner_environment/n    resolved_deps := object.get(artifact_evidence.predicate.buildDefinition, "resolvedDependencies", [])/n    some dep in resolved_deps/n    uri := object.get(dep, "uri", "")/n    startswith(uri, input.params.uri_prefix)/n}/n/nshould_allow if {/n    some artifact_evidence in artifacts_evidence/n    slsa_match(artifact_evidence)/n}/n/n/n/nexplanation := "No artifact has SLSA evidence with runner_environment = github-hosted and resolvedDependencies.uri starting with the specified prefix." if {/n    should_allow == false/n}/nexplanation := "" if {/n    should_allow == true/n}/n/nallow := {/n    "should_allow": should_allow,/n    "explanation": explanation/n}